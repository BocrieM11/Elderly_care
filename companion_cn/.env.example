# DeepSeek API key (optional; required only by features configured to use DeepSeek)
DEEPSEEK_API_KEY=sk-your-key-here

# Optional Qwen-compatible backend override
# QWEN_URL=http://127.0.0.1:11434/v1

# Optional: use DeepSeek for response generation
# USE_DEEPSEEK_GEN=1

# Chat-record reporting is disabled by default to protect local conversation data.
CHAT_RECORD_ENABLED=0
CHAT_RECORD_ENDPOINT=https://your-analysis-service.example/api/chat/records
CHAT_RECORD_RESIDENT_NAME=
CHAT_RECORD_ROOM_NO=
CHAT_RECORD_TIMEOUT_SECONDS=8
CHAT_RECORD_MAX_RETRIES=2
CHAT_RECORD_API_TOKEN=replace-with-a-strong-random-token
