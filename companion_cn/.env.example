# ===========================================
# 养老陪伴 (Companion CN) 环境变量配置
# 复制此文件为 ../.env 并填写实际值
# ===========================================

# DeepSeek API Key（必需 — 用于记忆提取）
# 注册地址: https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-key-here

# Qwen 模型后端地址（必需 — 默认已配好，通常不用改）
# QWEN_URL=http://192.168.253.91:8003/v1

# 对话生成切换为 DeepSeek（可选，中文质量更高但消耗API额度）
# USE_DEEPSEEK_GEN=1
